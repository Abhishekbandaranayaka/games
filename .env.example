# Copy this file to .env for local development. Never commit the real .env file.
# The example matches compose.dev.yml, which exposes MySQL only on localhost:3307.
DATABASE_URL="mysql://higanna_app:higanna_dev_password@127.0.0.1:3307/higanna_dev"

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# This is the complete Better Auth API URL, including the app base path.
BETTER_AUTH_URL="http://127.0.0.1:3000/api/auth"

# Existing application settings.
HOST="127.0.0.1"
PORT="3000"
NEXT_PUBLIC_BASE_PATH=""

# Phase 4 coin economy. All values are positive whole coins.
SIGNUP_BONUS_COINS="100"
MATCH_ENTRY_COINS="10"
KING_PRIZE_PERCENT="70"
MATCH_HOLD_MINUTES="30"

# Production uses a long random password and its own DATABASE_URL.
# NEXT_PUBLIC_BASE_PATH must be /higanna when creating the production build.
# For the current development server use:
# BETTER_AUTH_URL="http://45.79.125.85/higanna/api/auth"
