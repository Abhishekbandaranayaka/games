generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Better Auth core models. Phase 2 will connect these tables to the HTTP and
// Socket.IO authentication flows without requiring a second identity schema.
model User {
  id            String     @id @db.VarChar(36)
  name          String     @unique @db.VarChar(100)
  email         String     @unique @db.VarChar(320)
  emailVerified Boolean    @default(false)
  image         String?    @db.Text
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  accounts Account[]
  sessions Session[]
  wallet   Wallet?

  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(36)
  userId    String   @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(36)
  userId                String    @db.VarChar(36)
  issuer                String    @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  idToken               String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(36)
  identifier String   @db.VarChar(320)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// The wallet balance is a fast projection. CoinLedger is the permanent audit
// history. Phase 4 will ensure both are changed in one database transaction.
model Wallet {
  id              String   @id @default(cuid()) @db.VarChar(36)
  userId          String   @unique @db.VarChar(36)
  balance         BigInt   @default(0)
  reservedBalance BigInt   @default(0)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries CoinLedger[]
  holds         CoinHold[]

  @@map("wallet")
}

model CoinLedger {
  id             String              @id @default(cuid()) @db.VarChar(36)
  walletId       String              @db.VarChar(36)
  type           CoinTransactionType
  amount         BigInt
  balanceAfter   BigInt
  idempotencyKey String              @unique @db.VarChar(191)
  referenceId    String?             @db.VarChar(191)
  description    String?             @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime            @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("coin_ledger")
}

model CoinHold {
  id             String         @id @default(cuid()) @db.VarChar(36)
  walletId       String         @db.VarChar(36)
  amount         BigInt
  status         CoinHoldStatus @default(ACTIVE)
  idempotencyKey String         @unique @db.VarChar(191)
  referenceId    String?        @db.VarChar(191)
  expiresAt      DateTime
  capturedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@index([expiresAt, status])
  @@map("coin_hold")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CoinTransactionType {
  SIGNUP_BONUS
  MATCH_ENTRY
  MATCH_REWARD
  MATCH_REFUND
  AD_REWARD
  SUBSCRIPTION_GRANT
  ADMIN_ADJUSTMENT
}

enum CoinHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}
